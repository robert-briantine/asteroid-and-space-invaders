{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "space-invaders-bis",
  "version": "1.0.0",
  "identifier": "com.spaceinvaders.bis",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Space Invaders Bis",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
